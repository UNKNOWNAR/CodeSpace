            "const int N = 200005;",
            "int spf[N];",
            "void sieve() {",
            "    for(int i=2; i<N; ++i) spf[i]=i;",
            "    for(int i=2; i*i<N; ++i) {",
            "        if(spf[i] == i) {",
            "            for(int j=i*i; j<N; j+=i) {",
            "                if(spf[j] == j) spf[j] = i;",
            "            }",
            "        }",
            "    }",
            "}",
            "",
            "vi primes(int x) {",
            "    vi res;",
            "    while(x>1) {",
            "        int p=spf[x];",
            "        res.pb(p);",
            "        while(x%p == 0) x/=p;",
            "    }",
            "    return res;",
            "}"
        ],
