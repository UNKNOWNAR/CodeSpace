    "Disjoint Set Union (DSU)": {
        "scope": "cpp",
        "prefix": ["dsu"],
        "body": [
            "class DSU {",
            "public:",
            "    vi par, size;",
            "    DSU(int n) {",
            "        size = vi(n, 1);",
            "        par = vi(n);",
            "        for(int i=0; i<n; ++i) par[i]=i;",
            "    }",
            "    int find(int u) {",
            "        if(par[u]==u) return u;",
            "        return par[u]=find(par[u]);",
            "    }",
            "    void unite(int u, int v) {",
            "        u=find(u), v=find(v);",
            "        if(u==v) return;",
            "        if(size[u]<size[v]) swap(u,v);",
            "        size[u]+=size[v];",
            "        par[v]=u;",
            "    }",
            "};"
        ],
        "description": "DSU Class Snippet"
    },
    "Segment Tree": {
        "scope": "cpp",
        "prefix": ["segtree", "sgt"],
        "body": [
            "class segTree {",
            "    int n;",
            "    vector<int> tree;",
            "",
            "    void buildTree(vector<int>& nums, int i, int l, int r) {",
            "        if (l == r) {",
            "            tree[i] = nums[l];",
            "            return;",
            "        }",
            "        int mid = (l+r)/2;",
            "        buildTree(nums, 2*i + 1, l, mid);",
            "        buildTree(nums, 2*i + 2, mid + 1, r);",
            "        tree[i] = tree[2*i + 1] + tree[2*i + 2];",
            "    }",
            "",
            "    void updateTree(int i, int l, int r, int target, int newVal) {",
            "        if (l == r) {",
            "            tree[i] = newVal;",
            "            return;",
            "        }",
            "        int mid = (l+r)/2;",
            "        if (target <= mid)",
            "            updateTree(2*i + 1, l, mid, target, newVal);",
            "        else",
            "            updateTree(2*i + 2, mid + 1, r, target, newVal);",
            "        tree[i] = tree[2*i + 1] + tree[2*i + 2];",
            "    }",
            "",
            "    int queryTree(int i, int l, int r, int ql, int qr) {",
            "        if (ql <= l && qr >= r)",
            "            return tree[i];",
            "        if (qr < l || ql > r)",
            "            return 0;",
            "        int mid = (l+r)/2;",
            "        return queryTree(2*i + 1, l, mid, ql, qr) +",
            "               queryTree(2*i + 2, mid + 1, r, ql, qr);",
            "    }",
            "",
            "public:",
            "    segTree(vector<int>& nums) {",
            "        n = nums.size();",
            "        tree.resize(4*n);",
            "        buildTree(nums, 0, 0, n-1);",
            "    }",
            "",
            "    void update(int target, int newVal) {",
            "        updateTree(0, 0, n-1, target, newVal);",
            "    }",
            "",
            "    int query(int st, int end) { ",
            "        return queryTree(0, 0, n-1, st, end);",
            "    }",
            "};"
        ],
        "description": "Segment Tree Snippet"
    },
